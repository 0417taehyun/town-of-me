LINKED_IN_CLIENT_ID=
LINKED_IN_CLIENT_SECRET=
LINKED_IN_REDIRECT_URI=http://localhost:3000/v1/auth/linkedin/callback
# Comma-separated LinkedIn emails that become the first admins while the database lists none; after that, admins
# add or remove admin emails at /admin and this list is ignored.
ADMIN_EMAILS=
# The LinkedIn callback returns here. Only the admin signs in, so it points at the editor; its origin must also be
# listed in ALLOWED_ORIGINS.
FRONTEND_URL=http://localhost:5173/admin
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_SITE_NAME=Town of Me
# Empty DATABASE_URL uses the in-memory store, which resets on every backend restart.
# For `docker compose up -d postgres` with the defaults below, use:
# DATABASE_URL=postgres://town_of_me:town_of_me@localhost:5432/town_of_me
DATABASE_URL=
# Used by compose.yaml to create the PostgreSQL database and the containerized backend's connection URL.
# Keep the password URL-safe because compose embeds it in DATABASE_URL.
POSTGRES_DB=town_of_me
POSTGRES_USER=town_of_me
POSTGRES_PASSWORD=town_of_me
# The town created on first start while the database has none. Defaults to the fictional sample in
# backend/seed/town.json; point it at a private file (for example .seed/town.json, ignored by git) to start
# from your own town.
# TOWN_SEED_PATH=.seed/town.json
