# Copy to .env.production on the server (ignored by git) and fill in. docker/README.md has the steps.

# The site's public host name, without https://. Caddy gets its certificates for this and for www. in front of it.
PUBLIC_HOST=town.example.com

# Optional: only for a town behind CloudFront (docker/README.md#behind-cloudfront). The first selects the Caddyfile that
# takes CloudFront's requests, the second is the host name CloudFront reaches this server by, and the third is the
# value of the X-Origin-Verify header CloudFront adds: openssl rand -hex 32
# CADDYFILE=Caddyfile.cloudfront
# ORIGIN_HOST=origin.town.example.com
# ORIGIN_VERIFY_SECRET=

# URL-safe, because compose embeds it in DATABASE_URL: openssl rand -hex 32
POSTGRES_PASSWORD=

# LinkedIn sign-in for /admin. Register https://${PUBLIC_HOST}/v1/auth/linkedin/callback in the LinkedIn app.
LINKED_IN_CLIENT_ID=
LINKED_IN_CLIENT_SECRET=
# Comma-separated LinkedIn emails that become the first admins while the database lists none.
ADMIN_EMAILS=

# Optional: Cloudflare Web Analytics for page views, referrers, devices, and countries. Add the site in Cloudflare's Web
# Analytics page and copy the token from its JS snippet. A change takes effect on the next `up -d --build`.
CLOUDFLARE_WEB_ANALYTICS_TOKEN=

# Optional: the title and one-line description a shared link shows in chat apps and feeds, beside the town picture.
# Left empty, they read "Town of Me" and a general line. A change takes effect on the next `up -d --build`.
SITE_TITLE=
SITE_DESCRIPTION=

# Optional: drafting residents' dialogue in /admin.
OPENROUTER_API_KEY=

# Optional: where the private town seed is, used once while the database has no town.
# TOWN_SEED_FILE=./.seed/town.json
