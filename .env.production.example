# Copy to .env.production on the server (ignored by git) and fill in. docker/README.md has the steps.

# The site's public address: https, no trailing slash.
PUBLIC_ORIGIN=https://town.example.com

# URL-safe, because compose embeds it in DATABASE_URL: openssl rand -hex 32
POSTGRES_PASSWORD=

# The Cloudflare Tunnel's token. Point the tunnel's public hostname at http://frontend:80.
CLOUDFLARE_TUNNEL_TOKEN=

# LinkedIn sign-in for /admin. Register ${PUBLIC_ORIGIN}/v1/auth/linkedin/callback in the LinkedIn app.
LINKED_IN_CLIENT_ID=
LINKED_IN_CLIENT_SECRET=
# Comma-separated LinkedIn emails that become the first admins while the database lists none.
ADMIN_EMAILS=

# Optional: drafting residents' dialogue in /admin.
OPENROUTER_API_KEY=

# Optional: where the private town seed is, used once while the database has no town.
# TOWN_SEED_FILE=./.seed/town.json
